{
  "name": "orchestra",
  "productName": "Orchestra",
  "version": "0.0.1",
  "private": true,
  "description": "A desktop AI coding crew that works in your own repos and asks your OK before anything leaves your PC.",
  "license": "UNLICENSED",
  "main": "out/main/index.js",
  "type": "commonjs",
  "scripts": {
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "start": "npm run build && electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "lint:tokens": "node tools/token-lint.mjs",
    "test": "vitest run",
    "e2e": "playwright test",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never",
    "guard": "node tools/spec-guard.mjs verify && node tools/layers-check.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "electron": "45.2.3",
    "electron-builder": "26.18.1",
    "typescript": "5.9.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "dev.orchestra.desktop",
    "productName": "Orchestra",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["out/**", "package.json"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "icon": "build/icon.ico", "artifactName": "OrchestraSetup-${version}.exe" },
    "nsis": { "oneClick": false, "perMachine": false, "allowToChangeInstallationDirectory": false, "createStartMenuShortcut": true, "shortcutName": "Orchestra" }
  }
}
